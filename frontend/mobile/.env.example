# Base URL of the Laravel API.
#
# For an emulator/simulator on the same machine, 127.0.0.1 works.
# For a PHYSICAL DEVICE, replace the host with the LAN IP of the computer
# running Laravel, for example http://192.168.1.10:8000/api/v1, and start
# the backend with: php artisan serve --host=0.0.0.0
EXPO_PUBLIC_API_BASE_URL=http://192.168.1.10:8000/api/v1

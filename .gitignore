# ---------------------------------------------------------------------------
# School Management SaaS - root .gitignore
# Nested .gitignore files generated by Laravel / Vite / Expo are preserved.
# ---------------------------------------------------------------------------

# --- Environment files & secrets (never commit real credentials) -----------
.env
.env.*
!.env.example
!.env.*.example
*.pem
*.key
*.p12
*.pfx
*.keystore
*.jks
*.mobileprovision
secrets/
generated-secrets/
auth.json

# --- Dependencies ----------------------------------------------------------
node_modules/
vendor/
.pnp
.pnp.js

# --- Build output / bundles ------------------------------------------------
dist/
build/
out/
web-build/
.expo/
.expo-shared/
/android/
/ios/
public/build/
public/hot

# --- Laravel runtime artifacts --------------------------------------------
storage/*.key
bootstrap/cache/*.php
!bootstrap/cache/.gitignore
*.log
*.sqlite
*.sqlite3

# --- Test output / coverage ------------------------------------------------
coverage/
.nyc_output/
*.lcov
.phpunit.result.cache
junit.xml

# --- Package manager debug logs -------------------------------------------
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- IDE / editor temporary files -----------------------------------------
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json.example
*.swp
*.swo
*~
.fleet/
.nova/
.php-cs-fixer.cache
.phpactor.json
*.iml

# --- Operating system temporary files -------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini

# --- Local tooling caches --------------------------------------------------
.trae-cache/
.cache/
.turbo/
